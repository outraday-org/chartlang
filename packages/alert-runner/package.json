{
    "name": "@invinite-org/chartlang-alert-runner",
    "version": "1.1.0",
    "type": "module",
    "license": "MIT",
    "description": "Headless alert evaluator for compiled chartlang scripts (QuickJS, snapshots, frequencies)",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --coverage"
    },
    "dependencies": {
        "@invinite-org/chartlang-adapter-kit": "workspace:*",
        "@invinite-org/chartlang-core": "workspace:*",
        "@invinite-org/chartlang-host-quickjs": "workspace:*"
    },
    "devDependencies": {
        "@invinite-org/chartlang-compiler": "workspace:*",
        "@jitl/quickjs-wasmfile-release-sync": "0.31.0",
        "@types/node": "^20.0.0",
        "quickjs-emscripten-core": "0.31.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/outraday-org/chartlang.git",
        "directory": "packages/alert-runner"
    }
}
